NODE_ENV=development
LOG_LEVEL=info

# RabbitMQ (NeverStale docker-compose: user/password on localhost:5672)
# RABBITMQ_URL=amqp://user:password@localhost:5672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=password

WORKFLOW_LLM_EXCHANGE=neverstale.workflows
WORKFLOW_LLM_REQUEST_QUEUE=workflow.generate.request
WORKFLOW_LLM_RESPONSE_QUEUE=workflow.generate.response
WORKFLOW_LLM_REQUEST_ROUTING_KEY=workflow.generate.request
WORKFLOW_LLM_RESPONSE_ROUTING_KEY=workflow.generate.response
WORKFLOW_LLM_PREFETCH=1
WORKFLOW_LLM_MAX_RETRIES=3

# Narration generation (separate queues; same exchange as workflow LLM)
NARRATION_LLM_REQUEST_QUEUE=narration.generate.request
NARRATION_LLM_RESPONSE_QUEUE=narration.generate.response
NARRATION_LLM_REQUEST_ROUTING_KEY=narration.generate.request
NARRATION_LLM_RESPONSE_ROUTING_KEY=narration.generate.response
NARRATION_LLM_PREFETCH=1
NARRATION_LLM_MAX_RETRIES=3
# Narration uses LLM_PROVIDER / LLM_MODEL below; optional tuning overrides only
NARRATION_DISABLE_LLM=false

# Narration TTS (OpenAI speech API — required even when LLM_PROVIDER is not openai)
NARRATION_TTS_REQUEST_QUEUE=narration.tts.request
NARRATION_TTS_RESPONSE_QUEUE=narration.tts.response
NARRATION_TTS_REQUEST_ROUTING_KEY=narration.tts.request
NARRATION_TTS_RESPONSE_ROUTING_KEY=narration.tts.response
NARRATION_TTS_PREFETCH=1
NARRATION_TTS_MAX_RETRIES=3
TTS_MODEL=tts-1
TTS_VOICE=alloy
# Set true in tests/CI without calling OpenAI
TTS_DISABLE=false

# Narration captions (Whisper — OpenAI API; independent of LLM_PROVIDER)
NARRATION_CAPTION_REQUEST_QUEUE=narration.caption.request
NARRATION_CAPTION_RESPONSE_QUEUE=narration.caption.response
NARRATION_CAPTION_REQUEST_ROUTING_KEY=narration.caption.request
NARRATION_CAPTION_RESPONSE_ROUTING_KEY=narration.caption.response
NARRATION_CAPTION_PREFETCH=1
NARRATION_CAPTION_MAX_RETRIES=3
WHISPER_MODEL=whisper-1
# Set true in tests/CI without calling OpenAI
WHISPER_DISABLE=true
NARRATION_LLM_TEMPERATURE=0.3
NARRATION_LLM_MAX_TOKENS=4096

# LLM provider (workflow + narration): openai | anthropic | google | ollama
LLM_PROVIDER=google
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_REQUEST_TIMEOUT_MS=60000

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# LangSmith (workflow/narration LLM via LangChain + OpenAI TTS/Whisper via traceable)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=neverstale-workflow-llm
# When LANGSMITH_TRACING=true, set LANGSMITH_API_KEY; maps to LANGCHAIN_TRACING_V2 automatically
