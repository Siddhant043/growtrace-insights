NODE_ENV=development
LOG_LEVEL=info

# MongoDB
MONGO_URI=localhost:27017
MONGO_USER=admin
MONGO_PASSWORD=changeme
MONGO_DB=growtrace

# RabbitMQ (use either RABBITMQ_URL or HOST/USER/PASS/PORT)
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# LLM provider selection: openai | anthropic | google | ollama
LLM_PROVIDER=openai
# LLM_MODEL falls back per-provider when unset:
#   openai    -> gpt-4o-mini
#   anthropic -> claude-3-5-sonnet-latest
#   google    -> gemini-1.5-flash
#   ollama    -> llama3.1:8b
# LLM_MODEL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512
LLM_REQUEST_TIMEOUT_MS=30000

# Provider credentials (only the one matching LLM_PROVIDER is required)
OPENAI_API_KEY=
# OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# RabbitMQ topology (defaults are usually fine)
INSIGHTS_EXCHANGE=analytics_exchange
INSIGHTS_QUEUE=ai_insights_queue
INSIGHTS_DEAD_LETTER_EXCHANGE=ai_insights_dlx
INSIGHTS_DEAD_LETTER_QUEUE=ai_insights_dlq
INSIGHTS_DEAD_LETTER_ROUTING_KEY=ai_insights_dead
INSIGHTS_ROUTING_KEY=generate_insights
INSIGHTS_PREFETCH=1
INSIGHTS_MAX_RETRIES=3
INSIGHTS_RETRY_BACKOFF_MS=750
